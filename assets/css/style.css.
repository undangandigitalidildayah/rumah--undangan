
:root {
  --primary: #987567;
  --secondary: #d9b9a8;
  --background: #faf7f2;
  --text: #493b35;
  --muted: #8c7c73;
  --white: #ffffff;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, sans-serif;
  background: var(--background);
  color: var(--text);
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  cursor: pointer;
  font: inherit;
}

.container {
  width: min(1120px, 90%);
  margin: auto;
}

img {
  max-width: 100%;
  display: block;
}
