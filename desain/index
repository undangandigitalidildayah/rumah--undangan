<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Flyer Maker</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Lobster&family=Montserrat:wght@400;700&family=Oswald:wght@400;700&family=Pacifico&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Poppins:ital,wght@0,400;0,500;0,700;1,400&family=Roboto+Slab:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f5f4fb;--card:#fff;--soft:#f0eefa;--ink:#1c1b2e;--mut:#706f88;--line:#e4e2f0;--acc:#6d4aff;--acc2:#ff5f9e;--accink:#fff;--shadow:0 1px 2px #1c1b2e0f,0 6px 20px #1c1b2e0d;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#12121a;--card:#1c1c28;--soft:#262636;--ink:#f0f0fa;--mut:#9d9cb6;--line:#2f2f43;--acc:#8c75ff;--acc2:#ff7ab0;--shadow:0 1px 2px #0006,0 6px 20px #0004;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#12121a;--card:#1c1c28;--soft:#262636;--ink:#f0f0fa;--mut:#9d9cb6;--line:#2f2f43;--acc:#8c75ff;--acc2:#ff7ab0;--shadow:0 1px 2px #0006,0 6px 20px #0004;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 Poppins,system-ui,sans-serif}
.top{max-width:1120px;margin:0 auto;padding:18px 16px 6px;display:flex;gap:12px;align-items:center}
.logo{width:42px;height:42px;border-radius:13px;background:linear-gradient(135deg,var(--acc),var(--acc2));display:grid;place-items:center;font-size:21px;box-shadow:var(--shadow)}
.top h1{font-size:19px;margin:0;line-height:1.2}.top p{margin:0;color:var(--mut);font-size:12.5px}
.app{max-width:1120px;margin:0 auto;padding:10px 16px 16px;display:grid;gap:14px;grid-template-columns:1fr}
@media(min-width:960px){.app{grid-template-columns:minmax(0,1fr) 340px;align-items:start}.right{position:sticky;top:12px}}
.col{display:flex;flex-direction:column;gap:14px;min-width:0}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px;box-shadow:var(--shadow)}
.ch{display:flex;align-items:center;gap:9px;margin-bottom:11px}
.ch .n{width:24px;height:24px;border-radius:8px;background:var(--soft);color:var(--acc);font-weight:700;font-size:12px;display:grid;place-items:center}
.ch b{font-size:14px}.ch small{color:var(--mut);margin-left:auto;font-size:11.5px}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end}
.grow{flex:1 1 140px}
button,select,input,textarea{font:inherit;color:var(--ink)}
button{background:var(--soft);border:1px solid transparent;border-radius:11px;padding:8px 12px;cursor:pointer;transition:.15s;font-weight:500}
button:hover{border-color:var(--acc)}button:active{transform:scale(.97)}button:disabled{opacity:.45;pointer-events:none}
button.pri{background:linear-gradient(135deg,var(--acc),var(--acc2));color:var(--accink);font-weight:700;box-shadow:0 4px 14px #6d4aff44}
button.ghost{background:transparent;border-color:var(--line)}
button.on{background:var(--acc);color:var(--accink)}
button.danger{color:#e5484d}
select,input[type=number],input[type=text],textarea{background:var(--soft);border:1px solid transparent;border-radius:11px;padding:8px 10px;width:100%}
select:focus,input:focus,textarea:focus{outline:2px solid var(--acc);outline-offset:0}
input[type=color]{width:40px;height:36px;border:0;border-radius:10px;padding:0;background:none;cursor:pointer;flex:none}
input[type=range]{width:100%;accent-color:var(--acc)}
label{font-size:11.5px;color:var(--mut);display:flex;flex-direction:column;gap:4px;font-weight:500}
.cw{display:flex;gap:6px;align-items:center}.hex{width:88px!important;font-family:ui-monospace,monospace;font-size:12.5px}
textarea{min-height:62px;resize:vertical}
.hide{display:none!important}
.drop{border:1.5px dashed var(--line);border-radius:14px;padding:14px;background:var(--soft)}
#status{font-size:12.5px;color:var(--mut);margin-top:8px;min-height:16px}
.chips{display:flex;gap:6px;overflow-x:auto;padding-bottom:2px}
.chips button{white-space:nowrap;font-size:12.5px;padding:6px 11px;background:var(--soft)}
.tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.stage{background:repeating-conic-gradient(#8882 0 25%,transparent 0 50%) 0 0/16px 16px;border-radius:14px;padding:10px;display:flex;justify-content:center}
canvas{max-width:100%;height:auto;max-height:72vh;touch-action:none;background:#fff;border-radius:3px;box-shadow:0 6px 24px #0004}
.hint{color:var(--mut);font-size:11.5px;margin:8px 2px 0}
.shapes{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:10px}
.shapes button{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:10px;padding:8px 2px;line-height:1.15;text-align:center}
.shapes svg{width:26px;height:26px}
.gh{grid-column:1/-1;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);font-weight:700;margin-top:4px}
.gh:first-child{margin-top:0}
.sh{display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--soft);border-radius:12px;margin-bottom:12px}
.sh svg{width:20px;height:20px;color:var(--acc)}.sh b{font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sec{border-top:1px solid var(--line);padding-top:11px;margin-top:12px}
.sec>h4,details>summary{margin:0 0 8px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);font-weight:700;cursor:pointer}
.seg{display:flex;gap:4px}.seg button{flex:1;padding:7px 4px;font-size:12.5px}
.al{display:grid;grid-template-columns:repeat(6,1fr);gap:4px}.al button{padding:7px 0;font-size:15px}
.fade{border:1px solid var(--line);border-radius:12px;padding:8px;margin-bottom:8px;display:grid;gap:8px}
#layerList{display:flex;flex-direction:column;gap:5px;max-height:240px;overflow:auto}
.li{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:11px;background:var(--soft);cursor:pointer;border:1.5px solid transparent}
.li.sel{border-color:var(--acc)}.li svg{width:18px;height:18px;flex:none;color:var(--mut)}
.li span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12.5px}
.li button{padding:2px 7px;font-size:12px;background:transparent}
.dock{position:sticky;bottom:0;z-index:5;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-top:1px solid var(--line);padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px))}
.dock div{max-width:1120px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px}
.dock span{color:var(--mut);font-size:12px}.dock button{padding:11px 22px;font-size:14.5px}
</style>
<header class="top"><div class="logo">🎨</div><div><h1>Flyer Maker</h1><p>Tiru layout contoh, isi dengan desainmu sendiri</p></div></header>

<main class="app">
<div class="col">
  <section class="card">
    <div class="ch"><span class="n">1</span><b>Contoh layout</b><small>opsional</small></div>
    <div class="drop">
      <div class="row">
        <input type="file" id="file" accept="image/*" class="hide">
        <button class="pri" id="pick">Upload contoh flyer</button>
        <button id="ai" disabled>Tiru layout otomatis</button>
        <button id="refdel" class="ghost hide">Hapus contoh</button>
      </div>
      <div id="refCtl" class="hide" style="margin-top:10px;max-width:280px"><label>Transparansi contoh (panduan, tidak ikut diunduh)<input type="range" id="refop" min="0" max="100" value="40"></label></div>
      <div id="status">Upload flyer untuk meniru posisi teks, foto, dan bentuknya. Isi dan latar tetap milikmu.</div>
    </div>
  </section>

  <section class="card">
    <div class="ch"><span class="n">2</span><b>Kanvas dan latar</b></div>
    <div class="chips" id="sizes"></div>
    <div class="row" style="margin-top:12px">
      <label style="width:92px">Lebar<input type="number" id="csw" min="0" step="any"></label>
      <label style="width:92px">Tinggi<input type="number" id="csh" min="0" step="any"></label>
      <label style="width:100px">Satuan<select id="csu"><option value="px">Pixel</option><option value="cm">Cm</option><option value="mm">Mm</option><option value="in">Inchi</option></select></label>
      <label style="width:84px" id="csdpiw" class="hide">DPI<input type="number" id="csdpi" value="300" min="50" max="1200"></label>
      <button class="pri" id="csapply">Terapkan</button>
    </div>
    <p class="hint" id="csinfo" style="margin-top:6px">Ukuran sendiri, 50 sampai 8000 px per sisi. Cm, Mm, dan Inchi dihitung dengan DPI.</p>
    <div class="row" style="margin-top:12px">
      <label>Warna latar<span class="cw"><input type="color" id="bgc" value="#ffffff"><input type="text" id="bgh" class="hex" value="#ffffff" maxlength="7"></span></label>
      <label>Semua teks<span class="cw"><input type="color" id="allcol" value="#111111"><input type="text" id="allh" class="hex" value="#111111" maxlength="7"></span></label>
      <div class="row"><input type="file" id="bgf" accept="image/*" class="hide"><button id="bgup">Upload gambar latar</button><button id="bgdel" class="ghost hide">Hapus latar</button></div>
    </div>
    <div id="bgCtl" class="hide" style="margin-top:12px">
      <div class="row"><label class="grow">Transparan<input type="range" id="bgop" min="0" max="100" value="100"></label><label class="grow">Blend<select id="bgblend"></select></label></div>
      <details style="margin-top:10px"><summary>Gradasi latar</summary><div id="bgfades"></div></details>
    </div>
  </section>

  <section class="card">
    <div class="ch"><span class="n">3</span><b>Desain</b><small id="dim"></small></div>
    <div class="tools">
      <button id="addT">Teks</button>
      <button id="addS">Bentuk</button>
      <button id="addI">Foto</button>
      <input type="file" id="imgf" accept="image/*" class="hide">
    </div>
    <div id="shapeGrid" class="shapes hide"></div>
    <div class="stage"><canvas id="cv"></canvas></div>
    <p class="hint">Ketuk objek untuk memilih, geser untuk memindah, tarik kotak biru di pojok kanan bawah untuk mengubah ukuran. Pada teks, kotak biru memperbesar atau memperkecil huruf, dan bulatan biru di sisi kanan mengatur lebar baris.</p>
  </section>

  <section class="card">
    <div class="ch"><span class="n">4</span><b>Pengaturan unduhan</b><small id="dlout"></small></div>
    <label>Resolusi (sisi terpanjang, maksimal 4K)</label>
    <div class="chips" id="dlsizes" style="margin-top:6px"></div>
    <div class="row" style="margin-top:12px">
      <label class="grow">Format<select id="dlfmt"><option value="jpeg">JPEG</option><option value="png">PNG</option><option value="webp">WebP</option></select></label>
      <label class="grow" id="dlqwrap">Kualitas <span id="dlqv">95</span>%<input type="range" id="dlq" min="50" max="100" value="95"></label>
    </div>
    <p class="hint" id="dlnote"></p>
  </section>
</div>

<aside class="col right">
  <section class="card">
    <div class="ch"><b>Properti</b></div>
    <div id="noSel" style="color:var(--mut);font-size:13px">Pilih objek di flyer atau di daftar objek untuk mengeditnya.</div>
    <div id="selUI" class="hide">
      <div class="sh"><span id="selIcon"></span><b id="selName"></b></div>

      <div id="textUI">
        <textarea id="txt"></textarea>
        <div class="row" style="margin-top:8px">
          <label class="grow">Font<select id="font"></select></label>
          <label style="width:76px">Ukuran<input type="number" id="fsize" min="8" max="3000"></label>
        </div>
        <div class="row" style="margin-top:8px"><label>Warna<span class="cw"><input type="color" id="tcol"><input type="text" id="tch" class="hex" maxlength="7"></span></label></div>
        <div class="seg" style="margin-top:8px"><button id="bold"><b>B</b></button><button id="ital"><i>I</i></button><button id="aL">Kiri</button><button id="aC">Tengah</button><button id="aR">Kanan</button></div>
      </div>

      <div id="shapeUI">
        <div class="row">
          <label class="grow">Jenis bentuk<select id="kind"></select></label>
          <label>Warna<span class="cw"><input type="color" id="fill"><input type="text" id="fh" class="hex" maxlength="7"></span></label>
        </div>
        <label id="radWrap" style="margin-top:8px">Sudut bulat<input type="range" id="rad" min="0" max="300"></label>
      </div>

      <div id="slotUI" class="row"><button id="slotpick" class="pri">Pilih foto</button><button id="slotclr" class="ghost hide">Kosongkan</button></div>
      <button id="eye" class="ghost hide" style="margin-top:8px;width:100%">Pipet warna dari contoh</button>

      <div class="sec"><h4>Posisi di kanvas</h4>
        <div class="al"><button data-al="l" title="Rata kiri">⇤</button><button data-al="ch" title="Tengah horizontal">↔</button><button data-al="r" title="Rata kanan">⇥</button><button data-al="t" title="Rata atas">⤒</button><button data-al="cv" title="Tengah vertikal">↕</button><button data-al="b" title="Rata bawah">⤓</button></div>
      </div>

      <div class="sec"><h4>Efek</h4>
        <label>Transparan<input type="range" id="lop" min="0" max="100" value="100"></label>
        <div class="row" style="margin-top:8px"><label class="grow">Blend<select id="lblend"></select></label></div>
        <label style="margin-top:8px">Putar (derajat)<input type="range" id="lrot" min="-180" max="180" value="0"></label>
      </div>

      <details class="sec"><summary>Gradasi transparan</summary><div id="lfades"></div></details>

      <div class="sec"><h4>Susunan</h4>
        <div class="row"><button id="up">Naik</button><button id="down">Turun</button><button id="dup">Gandakan</button><button id="del" class="danger">Hapus</button></div>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="ch"><b>Daftar objek</b></div>
    <div id="layerList"></div>
  </section>
</aside>
</main>

<div class="dock"><div><span id="dlsum"></span><button class="pri" id="dl">Download</button></div></div>

<script>
const $=id=>document.getElementById(id);
const FONTS=["Poppins","Montserrat","Playfair Display","Bebas Neue","Oswald","Roboto Slab","Lobster","Pacifico"];
const BLENDS=[['normal','Normal'],['multiply','Multiply (gelap)'],['screen','Screen (terang)'],['overlay','Overlay'],['soft-light','Soft light'],['hard-light','Hard light'],['darken','Darken'],['lighten','Lighten'],['color-dodge','Color dodge'],['difference','Difference']];
const FADES=[['b','Hilang ke bawah'],['t','Hilang ke atas'],['r','Hilang ke kanan'],['l','Hilang ke kiri'],['c','Pudar ke pinggir']];
const SHAPES=[['circle','Circle'],['square','Square'],['rect','Rectangle'],['rrect','Rounded Rectangle'],['ellipse','Ellipse'],['oval','Oval'],['triangle','Triangle'],['rtriangle','Right Triangle'],['semicircle','Semicircle'],['quarter','Quarter Circle']];
const ICON={circle:'<circle cx="12" cy="12" r="9"/>',square:'<rect x="4" y="4" width="16" height="16"/>',rect:'<rect x="2" y="7" width="20" height="10"/>',rrect:'<rect x="2" y="6" width="20" height="12" rx="3.5"/>',ellipse:'<ellipse cx="12" cy="12" rx="10" ry="6.5"/>',oval:'<rect x="2" y="7" width="20" height="10" rx="5"/>',triangle:'<path d="M12 3 22 21H2z"/>',rtriangle:'<path d="M4 3v18h16z"/>',semicircle:'<path d="M2 17a10 10 0 0 1 20 0z"/>',quarter:'<path d="M4 20V4a16 16 0 0 1 16 16z"/>',text:'<path d="M5 5h14v3h-5.5v11h-3V8H5z"/>',slot:'<path d="M3 5h18v14H3zm3 11h12l-4-5-3 4-2-2z" fill-rule="evenodd"/>'};
const svg=k=>`<svg viewBox="0 0 24 24" fill="currentColor">${ICON[k]||ICON.rect}</svg>`;
const POLYS=[['pentagon','Pentagon'],['hexagon','Hexagon'],['heptagon','Heptagon'],['octagon','Octagon'],['nonagon','Nonagon'],['decagon','Decagon'],['dodecagon','Dodecagon'],['diamond','Diamond'],['parallelogram','Parallelogram'],['trapezoid','Trapezoid'],['rhombus','Rhombus'],['kite','Kite'],['chevron','Chevron']];
const ALLSHAPES=SHAPES.concat(POLYS);
const NGON={pentagon:5,hexagon:6,heptagon:7,octagon:8,nonagon:9,decagon:10,dodecagon:12};
const POLYK=Object.fromEntries(POLYS.map(s=>[s[0],1]));
const POLYR={parallelogram:.6,trapezoid:.6,rhombus:.6,chevron:.6};
function polyPts(k,x,y,w,h){
  if(NGON[k]){
    const n=NGON[k],a0=n%2?-Math.PI/2:-Math.PI/2+Math.PI/n,p=[];
    for(let i=0;i<n;i++){const a=a0+2*Math.PI*i/n;p.push([Math.cos(a),Math.sin(a)])}
    const xs=p.map(q=>q[0]),ys=p.map(q=>q[1]),x0=Math.min(...xs),x1=Math.max(...xs),y0=Math.min(...ys),y1=Math.max(...ys);
    return p.map(q=>[x+(q[0]-x0)/(x1-x0)*w,y+(q[1]-y0)/(y1-y0)*h]);
  }
  let u;
  if(k==='diamond')u=[[.5,0],[1,.5],[.5,1],[0,.5]];
  else if(k==='parallelogram')u=[[.25,0],[1,0],[.75,1],[0,1]];
  else if(k==='trapezoid')u=[[.2,0],[.8,0],[1,1],[0,1]];
  else if(k==='kite')u=[[.5,0],[1,.38],[.5,1],[0,.38]];
  else if(k==='chevron')u=[[0,0],[.6,0],[1,.5],[.6,1],[0,1],[.4,.5]];
  else if(k==='rhombus'){const s=w>h?(w*w-h*h)/(2*w)/w:.3;u=[[s,0],[1,0],[1-s,1],[0,1]]}
  return (u||[[0,0],[1,0],[1,1],[0,1]]).map(q=>[x+q[0]*w,y+q[1]*h]);
}
POLYS.forEach(([k])=>{const r=POLYR[k]||1,h=18*r,p=polyPts(k,3,12-h/2,18,h);ICON[k]='<polygon points="'+p.map(q=>q[0].toFixed(2)+','+q[1].toFixed(2)).join(' ')+'"/>'});
const SIZES=[['1080x1080','Persegi 1080'],['1080x1350','Portrait 1080x1350'],['1080x1920','Story 1080x1920'],['1240x1754','A4'],['1920x1080','Landscape']];

const cv=$('cv');let ctx=cv.getContext('2d');let MAIN=ctx;const VIEW=ctx;let S=1;const tcv=document.createElement('canvas'),tctx=tcv.getContext('2d');
let dlSize=3840,dlFmt='jpeg',dlQ=.95;
const DLSIZES=[[0,'Asli'],[1920,'Full HD 1920'],[2560,'2K 2560'],[3840,'4K 3840']];
let W=1080,H=1350,bg='#ffffff',layers=[],sel=null,ref=null,refFile=null,refOp=.4,eye=false,uid=1,drag=null,bgImg=null,bgOp=1,bgBlend='normal',bgFades=[];

function fill(sel_,list,val){list.forEach(([v,t])=>{const o=document.createElement('option');o.value=v;o.textContent=t;sel_.appendChild(o)})}
FONTS.forEach(f=>{const o=document.createElement('option');o.textContent=f;$('font').appendChild(o)});
fill($('lblend'),BLENDS);fill($('bgblend'),BLENDS);
[['Basic Shape',SHAPES],['Polygon Shape',POLYS]].forEach(([t,list])=>{const g=document.createElement('optgroup');g.label=t;fill(g,list);$('kind').appendChild(g)});
SIZES.forEach(([v,t])=>{const b=document.createElement('button');b.textContent=t;b.dataset.v=v;b.onclick=()=>{const [w,h]=v.split('x').map(Number);setSize(w,h)};$('sizes').appendChild(b)});
[['Basic Shape',SHAPES],['Polygon Shape',POLYS]].forEach(([title,list])=>{
  const h=document.createElement('div');h.className='gh';h.textContent=title;$('shapeGrid').appendChild(h);
  list.forEach(([k,t])=>{const b=document.createElement('button');b.innerHTML=svg(k)+'<span>'+t+'</span>';b.onclick=()=>{addShape(k);$('shapeGrid').classList.add('hide')};$('shapeGrid').appendChild(b)});
});

function setSize(w,h,keep){
  if(layers.length&&(W!==w||H!==h)){
    const sx=w/W,sy=h/H;
    layers.forEach(l=>{l.x*=sx;l.w*=sx;l.y*=sy;l.h*=sy;if(l.radius)l.radius*=sx;if(l.type==='text')l.size*=sx;if(lock(l))l.h=l.w});
  }
  W=w;H=h;cv.width=w;cv.height=h;$('dim').textContent=w+' x '+h+' px';[...$('sizes').children].forEach(b=>b.classList.toggle('on',b.dataset.v===w+'x'+h));
  if(!keep)syncSizeInputs();
  if(typeof sel!=='undefined'&&sel)syncProps();
  updateDl();draw();
}
const UNITPX=(u,dpi)=>u==='px'?1:u==='in'?dpi:u==='cm'?dpi/2.54:dpi/25.4;
const csDpi=()=>Math.min(1200,Math.max(50,+$('csdpi').value||300));
function syncSizeInputs(){
  const u=$('csu').value,k=UNITPX(u,csDpi()),f=v=>u==='px'?String(Math.round(v)):String(+v.toFixed(2));
