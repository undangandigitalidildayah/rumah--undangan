    status('Contoh dimuat. Tekan "Tiru layout otomatis" atau susun manual di atas panduan.');syncProps();draw();
  }catch(err){status('Gambar tidak bisa dibaca.')}
  e.target.value='';
};
function layoutPrompt(){return `Ini gambar contoh flyer. Tiru LAYOUT-nya saja: posisi dan ukuran blok teks, area foto/gambar, dan bentuk dekoratif (panel, pita, lingkaran, segitiga, dll). JANGAN salin latar belakang penuh. JANGAN salin isi teks asli: ganti dengan placeholder pendek berbahasa Indonesia sesuai fungsinya (misal Judul Utama, Subjudul, Tanggal dan Waktu, Lokasi, Kontak). Balas HANYA JSON valid tanpa teks lain:
{"layers":[...]} berurutan dari belakang ke depan. Posisi dan ukuran dalam PERSEN (0-100) dari lebar/tinggi flyer; x,y pojok kiri atas.
Area foto/ilustrasi/logo: {"type":"slot","x":..,"y":..,"w":..,"h":..,"radius":persen_lebar}
Bentuk: {"type":"shape","kind":"circle|square|rect|rrect|ellipse|oval|triangle|rtriangle|semicircle|quarter|pentagon|hexagon|heptagon|octagon|nonagon|decagon|dodecagon|diamond|parallelogram|trapezoid|rhombus|kite|chevron","x":..,"y":..,"w":..,"h":..,"fill":"#hex","radius":persen_lebar,"rot":derajat}
Teks: {"type":"text","text":"placeholder","x":..,"y":..,"w":lebar_blok,"size":tinggi_huruf_persen_lebar,"color":"#hex","font":"salah satu dari ${FONTS.join(', ')}","bold":true/false,"italic":true/false,"align":"left|center|right"}
Pilih font yang gayanya paling mirip. Maksimal 40 elemen.`}
$('ai').onclick=async()=>{
  if(!refFile)return;$('ai').disabled=true;status('Claude sedang membaca flyer...');
  try{
    const sample=await claude.use('sample');
    if(!sample){status('Fitur otomatis tidak tersedia di sini. Pakai panduan dan tambah objek manual.');return}
    const res=await sample(layoutPrompt(),{images:[refFile],modelTier:'default',cache:false});
    const txt=(res.text||'').replace(/```json|```/g,'').trim();
    const data=JSON.parse(txt.slice(txt.indexOf('{'),txt.lastIndexOf('}')+1));
    layers=[];sel=null;for(const f of FONTS)try{await document.fonts.load(`bold 20px "${f}"`)}catch(e){}
    (data.layers||[]).slice(0,60).forEach(o=>{
      const n=v=>Number(v)||0,x=n(o.x)*W/100,y=n(o.y)*H/100,w=Math.max(10,n(o.w)*W/100),h=Math.max(10,n(o.h)*H/100);
      const col=c=>/^#[0-9a-f]{6}$/i.test(c||'')?c:'#6d4aff';
      if(o.type==='slot')layers.push(mk({type:'slot',img:null,x,y,w,h,radius:n(o.radius)*W/100}));
      else if(o.type==='shape'||o.type==='rect'){let k=ALLSHAPES.some(s=>s[0]===o.kind)?o.kind:(o.type==='rect'?'rect':'rect');layers.push(mk({type:'shape',kind:k,x,y,w,h:(k==='circle'||k==='square')?w:h,fill:col(o.fill),radius:n(o.radius)*W/100,rot:n(o.rot)}))}
      else if(o.type==='text')layers.push(mk({type:'text',text:String(o.text||''),x,y,w,h:50,font:FONTS.includes(o.font)?o.font:'Poppins',size:Math.max(10,n(o.size)*W/100),color:/^#[0-9a-f]{6}$/i.test(o.color||'')?o.color:'#111111',bold:!!o.bold,italic:!!o.italic,align:['left','center','right'].includes(o.align)?o.align:'left'}));
    });
    refOp=0;$('refop').value=0;select(null);
    status('Layout selesai. Upload latar kamu, isi kotak Foto, dan ganti teksnya. Geser "Transparansi contoh" untuk membandingkan.');
  }catch(err){status(err&&err.code==='not_granted'?'Izin ditolak. Kamu tetap bisa menyusun manual di atas panduan.':'Gagal membaca otomatis. Coba lagi atau susun manual.')}
  finally{$('ai').disabled=!refFile}
};

$('dlfmt').onchange=()=>{dlFmt=$('dlfmt').value;updateDl()};
$('dlq').oninput=()=>{dlQ=$('dlq').value/100;updateDl()};
async function saveBlob(blob,name){
  let d=null;try{if(window.claude&&claude.use)d=await claude.use('downloads')}catch(e){}
  if(d){
    try{await d.save({filename:name,data:blob});info('Tersimpan: '+name)}
    catch(err){info(err&&err.code==='declined'?'Unduhan dibatalkan.':'Download gagal: '+(err&&err.message||'coba lagi'))}
    return;
  }
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(a.href),10000);info('Mengunduh '+name);
}
$('dl').onclick=async()=>{
  const btn=$('dl'),{s,w,h}=outSize(),prev=sel;
  btn.disabled=true;btn.textContent='Memproses...';info('Merender '+w+' x '+h+' px...');
  try{
    sel=null;
    await Promise.all(layers.filter(l=>l.type==='text').map(l=>document.fonts.load(fontStr(l)).catch(()=>{})));
    await new Promise(r=>setTimeout(r,30));
    const out=document.createElement('canvas');out.width=w;out.height=h;
    MAIN=out.getContext('2d');S=w/W;draw(true);
    MAIN=VIEW;S=1;
    const mime={jpeg:'image/jpeg',png:'image/png',webp:'image/webp'}[dlFmt];
    const blob=await new Promise(r=>out.toBlob(r,mime,dlQ));
    out.width=out.height=1;
    if(!blob||blob.type!==mime)throw new Error('Browser tidak bisa membuat gambar sebesar ini. Pilih resolusi atau format lain.');
    await saveBlob(blob,'flyer-'+w+'x'+h+'.'+(dlFmt==='jpeg'?'jpg':dlFmt));
  }catch(err){info('Download gagal: '+(err&&err.message||'coba lagi'))}
  finally{MAIN=VIEW;S=1;sel=prev;draw();btn.disabled=false;btn.textContent='Download'}
};

